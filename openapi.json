        ],
        "summary": "Çoklu medya sorgusu",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "20,30,41"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eşleşen medya kayıtları."
          },

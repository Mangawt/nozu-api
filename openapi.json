{
  "public_url": "https://nozu.me",
  "openapi": "3.0.3",
  "info": {
    "title": "Nozu Public API",
    "version": "1.1.0",
    "description": "Nozu anime, manga, karakter, kişi, stüdyo ve public kullanıc verilerini sunan ücretsiz REST API.",
    "contact": {
      "name": "Nozu",
      "email": "nozudestek@naver.com"
    }
  },
  "servers": [
    {
      "url": "https://nozu.me/api/v1",
      "description": "Nozu API v1"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Arama ve Keşif",
      "description": "Anime ve manga arama, trend, popüler ve keşif endpointleri."
    },
    {
      "name": "Anime ve Manga",
      "description": "Anime/manga detayları ve çoklu medya sorguları."
    },
    {
      "name": "Katalog",
      "description": "Karakter, kişi, stüdyo ve etiket verileri."
    },
    {
      "name": "Public Profiller",
      "description": "Nozu kullanıcılarının herkese açık profil ve liste verileri."
    },
    {
      "name": "Sistem",
      "description": "API tanımı ve sistem yardımcıları."
    }
  ],
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": "Sayfa numarası."
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 24
        },
        "description": "Sayfa başına kayıt."
      },
      "Type": {
        "name": "type",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "anime",
            "manga"
          ]
        },
        "description": "Medya türü."
      },
      "Fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Virgülle ayrılmış response alanları."
      },
      "Include": {
        "name": "include",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "characters, relations, recommendations, staff, external_links, streaming_episodes, tags, rankings, stats."
      },
      "Slug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Nozu slug değeri."
      },
      "Username": {
        "name": "username",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Nozu kullanıcı adı."
      }
    },
    "headers": {
      "XRateLimitLimit": {
        "description": "İstek penceresindeki maksimum istek sayısı.",
        "schema": {
          "type": "integer",
          "example": 60
        }
      },
      "XRateLimitRemaining": {
        "description": "Mevcut pencere içinde kalan istek sayısı.",
        "schema": {
          "type": "integer",
          "example": 59
        }
      },
      "RetryAfter": {
        "description": "429 sonrasında yeniden denemeden önce beklenecek saniye.",
        "schema": {
          "type": "integer",
          "example": 37
        }
      }
    },
    "schemas": {
      "StandardSuccess": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "nullable": true
          },
          "meta": {
            "type": "object",
            "nullable": true
          },
          "links": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "StandardError": {
        "type": "object",
        "required": [
          "success",
          "message",
          "errors"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Kayıt bulunamadı."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 24
          },
          "total": {
            "type": "integer",
            "example": 120
          },
          "last_page": {
            "type": "integer",
            "example": 5
          },
          "from": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "to": {
            "type": "integer",
            "nullable": true,
            "example": 24
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "nullable": true
          },
          "last": {
            "type": "string",
            "nullable": true
          },
          "prev": {
            "type": "string",
            "nullable": true
          },
          "next": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "MediaSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "anime",
              "manga"
            ]
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "cover_image": {
            "type": "string",
            "nullable": true
          },
          "banner_image": {
            "type": "string",
            "nullable": true
          },
          "format": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "average_score": {
            "type": "number",
            "nullable": true
          },
          "popularity": {
            "type": "integer",
            "nullable": true
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PublicUser": {
        "type": "object",
        "description": "Nozu kullanıcısının yalnızca herkese açık profil verileri.",
        "properties": {
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "nullable": true
          },
          "banner": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "followers_count": {
            "type": "integer"
          },
          "following_count": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Kayıt bulunamadı.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Parametreler geçersiz.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardError"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit aşıldı.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StandardError"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/search": {
      "get": {
        "tags": [
          "Arama ve Keşif"
        ],
        "summary": "Anime ve manga arama",
        "description": "Filtrelenebilir ve sayfalı anime/manga katalog araması.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "$ref": "#/components/parameters/Type"
          },
          {
            "name": "genre",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            }
          },
          {
            "name": "season",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "studio",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "adult",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "minimum_score",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "maximum_score",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/Fields"
          },
          {
            "$ref": "#/components/parameters/Include"
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı sonuç."
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/discover": {
